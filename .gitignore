# Root .gitignore — repo-wide safety net for secrets and common junk.
# Per-app rules also live in miv/.gitignore and miv-backend/.gitignore.

# Environment files (secrets) — never commit. Templates are kept.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies / build output
node_modules/
**/node_modules/
.next/
**/.next/

# OS / editor
.DS_Store
*.log
