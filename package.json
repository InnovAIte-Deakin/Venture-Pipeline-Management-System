{
  "name": "venture-management-system",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "postinstall": "prisma generate --schema=./src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=./src/prisma/schema.prisma",
    "db:push": "prisma db push --schema=./src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./src/prisma/schema.prisma",
    "db:seed": "tsx ./src/prisma/seed.ts",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:repo": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.58.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@payloadcms/db-mongodb": "3.49.1",
    "@payloadcms/next": "3.49.1",
    "@payloadcms/payload-cloud": "3.49.1",
    "@payloadcms/richtext-lexical": "3.49.1",
    "@payloadcms/ui": "3.49.1",
    "@prisma/client": "^6.13.0",
    "@radix-ui/react-avatar": "^1.1.10",
