    "mongodb": "^6.19.0",
    "next": "15.2.9",
    "next-auth": "^4.24.11",
    "nodemailer": "^7.0.7",
    "openai": "^5.12.0",
    "payload": "3.49.1",
    "postcss": "^8.5.6",
    "react": "19.1.1",
    "react-day-picker": "^9.10.0",
    "react-dom": "19.1.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4",
    "resend": "^6.0.3",
    "sharp": "0.34.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
