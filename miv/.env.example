# Database Configuration
DATABASE_URL=postgresql://app_miv:supersecret@localhost:5432/app_miv
DATABASE_PROVIDER=postgresql

# PostgreSQL Direct Connection (for docker-compose)
POSTGRES_USER=app_miv
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=app_miv

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
PUBLIC_BACKEND_URL=http://localhost:3001

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# REQUIRED for route auth (proxy.ts): must EXACTLY match the backend's PAYLOAD_SECRET.
# The proxy verifies the payload-token JWT signature locally with this. Server-side only
# (never NEXT_PUBLIC_*). If unset or mismatched, the proxy fails closed and bounces every
# protected route to /auth/login.
PAYLOAD_SECRET=must-match-miv-backend-PAYLOAD_SECRET

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Services (optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Node Environment
NODE_ENV=development
