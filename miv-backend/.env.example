DATABASE_URI=mongodb://127.0.0.1/VPMSclients
PAYLOAD_SECRET=generate-a-strong-random-secret-here

# Seed credentials — required for first-run user seeding
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-production
SEED_FOUNDER_EMAIL=founder@example.com
SEED_FOUNDER_PASSWORD=change-me-in-production
SEED_ANALYST_EMAIL=analyst@example.com
SEED_ANALYST_PASSWORD=change-me-in-production

# SMTP Configuration for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Email Recipients
ADMIN_NOTIFICATION_EMAIL=your-admin-email@example.com

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
