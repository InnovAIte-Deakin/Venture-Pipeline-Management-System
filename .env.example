# ─── Payload CMS / MongoDB ────────────────────────────────────────────────────
MONGODB_URI="mongodb://127.0.0.1:27017/payload"
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ─── Prisma / PostgreSQL ──────────────────────────────────────────────────────
# Local Docker:
DATABASE_URL="postgresql://app_miv:supersecret@localhost:5432/app_miv?schema=public"
# Vercel/serverless (add connection pooling params):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public&pgbouncer=true&connection_limit=1"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Set to your production URL in production (e.g. https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Payload CMS Seed Credentials ────────────────────────────────────────────
# Used on first startup to create default admin/founder/analyst users.
# REQUIRED in production — app will refuse to start without these.
SEED_ADMIN_EMAIL=admin@your-organisation.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: override the derived founder/analyst emails (defaults to +founder@ / +analyst@ aliases)
# SEED_FOUNDER_EMAIL=founder@your-organisation.com
# SEED_ANALYST_EMAIL=analyst@your-organisation.com

# ─── SMTP / Email ─────────────────────────────────────────────────────────────
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# Alternatives: Resend, Mailgun, SendGrid all support SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# ─── Email Recipients ─────────────────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=admin@your-organisation.com

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow same-origin only)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
